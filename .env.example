YELTRA_NATIVE_ADAPTER=
YELTRA_MARKET_DIRECTORY=0x9CA476Fa631273EB5Db83186115bDF3ABaccc951
YELTRA_MARKET_DIRECTORY_TESTNET=
NEXT_PUBLIC_YELTRA_MARKET_DIRECTORY=0x9CA476Fa631273EB5Db83186115bDF3ABaccc951
NEXT_PUBLIC_YELTRA_MARKET_DIRECTORY_TESTNET=

# Dividend Earn deployment metadata. Leave blank until the guarded Testnet
