# Robinhood Chain Network Configuration
NEXT_PUBLIC_ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
NEXT_PUBLIC_ROBINHOOD_CHAIN_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/
NEXT_PUBLIC_ROBINHOOD_CHAIN_ENV=mainnet
NEXT_PUBLIC_YELTRA_DATA_MODE=live
# Required public 32-character Reown / WalletConnect Cloud project ID.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server/local deployment workflow only. Never expose or commit the private key.
DEPLOYER_PRIVATE_KEY=
# Mainnet-only deployment workflow. Use a dedicated key; never reuse the Testnet key.
MAINNET_DEPLOYER_PRIVATE_KEY=
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_MAINNET_RPC_URL=
# Mainnet preparation only; never broadcast without explicit human review.
CLEAVE_MAINNET_CONFIRMATION=
YELTRA_MAINNET_CONFIRMATION=
PENDLE_MAINNET_ROUTER=
PENDLE_MAINNET_ADAPTER_ID=
