# Robinhood Chain Network Configuration
NEXT_PUBLIC_ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
NEXT_PUBLIC_ROBINHOOD_CHAIN_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/
NEXT_PUBLIC_ROBINHOOD_CHAIN_ENV=mainnet
NEXT_PUBLIC_YELTRA_DATA_MODE=live
# Required public 32-character Reown / WalletConnect Cloud project ID.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server/local deployment workflow only. Never expose or commit the private key.
DEPLOYER_PRIVATE_KEY=
# Mainnet-only deployment workflow. Use a dedicated key; never reuse the Testnet key.
MAINNET_DEPLOYER_PRIVATE_KEY=
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_MAINNET_RPC_URL=
# Mainnet preparation only; never broadcast without explicit human review.
CLEAVE_MAINNET_CONFIRMATION=
YELTRA_MAINNET_CONFIRMATION=
PENDLE_MAINNET_ROUTER=
PENDLE_MAINNET_ADAPTER_ID=

# Native USDG canary package. These are read by the guarded deployment and
# read-only post-deploy validation scripts; never commit private keys.
YELTRA_NATIVE_MAINNET_CONFIRMATION=
YELTRA_NATIVE_ACCESS_MANAGER=0xb12c7112446bfe88d6e82b516f5df90449fa3dc4
YELTRA_NATIVE_SOURCE_VAULT=0xBeEff033F34C046626B8D0A041844C5d1A5409dd
YELTRA_NATIVE_UNDERLYING=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
YELTRA_NATIVE_MATURITY=
YELTRA_NATIVE_MARKET_ID=
YELTRA_NATIVE_REGISTRY=
YELTRA_NATIVE_FACTORY=
YELTRA_NATIVE_ROUTER=
YELTRA_NATIVE_MARKET=
YELTRA_NATIVE_PT=
YELTRA_NATIVE_YT=
YELTRA_NATIVE_ADAPTER=
YELTRA_MARKET_DIRECTORY=
YELTRA_MARKET_DIRECTORY_TESTNET=
NEXT_PUBLIC_YELTRA_MARKET_DIRECTORY=
NEXT_PUBLIC_YELTRA_MARKET_DIRECTORY_TESTNET=
